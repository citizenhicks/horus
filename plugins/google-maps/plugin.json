{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "google-maps",
  "version": "1.0.0",
  "description": "Find places, weather, and routes with Google Maps.",
  "extensions": {
    "app.mobius": {
      "connection": {
        "type": "api_key",
        "server": "google-maps",
        "header": "X-Goog-Api-Key",
        "label": "Google Maps API key"
      }
    }
  }
}
